#!/usr/bin/env bash
set -Eeuo pipefail

TITLE="SG-Gateway 0.1.0-021.7 — Full Clean GitHub main + exact 22 accepted fixes — FIX2"
REPLAY_SHA="788bc3d3e534cfc14bc17117cddf1088cbc09a670e3e52f283f6094839eaa79f"
BOOTSTRAP_SHA="f2873361a9683717a49317831399c2d6a229506d49b7532e573caaacf87e1c41"
TMP="$(mktemp -d /tmp/sg0217-full-github22.XXXXXX)"
REPLAY="$TMP/SG-Gateway-0217-CHECKPOINT1-22-FIX-REPLAY.run"
BOOTSTRAP="$TMP/install-from-github.sh"
APP=""
BACKUP=""
BASE_INSTALLED=0
OVERLAY_STARTED=0
OVERLAY_COMMITTED=0
VERSION_WAS_PRESENT=0
PROTECTED_BEFORE="$TMP/protected-before.sha256"

log() { printf '[SG-Gateway] %s\n' "$*"; }
ok() { printf '\033[32m[SG-Gateway] [OK]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[SG-Gateway] [ВНИМАНИЕ]\033[0m %s\n' "$*"; }
fail() { printf '\033[31m[SG-Gateway] [ОШИБКА]\033[0m %s\n' "$*" >&2; exit 1; }
cleanup() { rm -rf "$TMP"; }

detect_app() {
  if [[ -f /opt/sg-gateway/app/web/templates/system.html ]]; then APP=/opt/sg-gateway; return 0; fi
  if [[ -f /opt/sg-gateway/current/app/web/templates/system.html ]]; then APP=/opt/sg-gateway/current; return 0; fi
  return 1
}

extract_embedded() {
  awk '/^__BOOTSTRAP_BEGIN__$/{p=1;next} /^__BOOTSTRAP_END__$/{p=0} p' "$0" | tr -d '\r\n' | base64 -d > "$BOOTSTRAP"
  awk '/^__REPLAY_BEGIN__$/{p=1;next} /^__REPLAY_END__$/{p=0} p' "$0" | tr -d '\r\n' | base64 -d > "$REPLAY"
  [[ "$(sha256sum "$BOOTSTRAP" | awk '{print $1}')" == "$BOOTSTRAP_SHA" ]] || fail "повреждён встроенный GitHub bootstrap"
  [[ "$(sha256sum "$REPLAY" | awk '{print $1}')" == "$REPLAY_SHA" ]] || fail "повреждён встроенный пакет 22 фиксов"
  chmod +x "$BOOTSTRAP" "$REPLAY"
  bash -n "$BOOTSTRAP" || fail "bootstrap: ошибка bash-синтаксиса"
  bash -n "$REPLAY" || fail "replay: ошибка bash-синтаксиса"
  "$REPLAY" --verify-only >/dev/null || fail "встроенные 22 фикса не прошли verify-only"
}

protected_hashes() {
  local out="$1" rel
  : > "$out"
  for rel in     app/web/templates/connections.html     app/web/templates/_mihomo_panel.html     app/mihomo/service.py     app/mihomo/helper.py     app/clients/exports.py     hostd/sg_hostd/client_runtime.py     hostd/sg_hostd/commands.py     hostd/sg_hostd/operation_jobs.py     hostd/sg_hostd/operation_job_runner.py
  do
    [[ -f "$APP/$rel" ]] || fail "после GitHub install отсутствует защищённый файл: $rel"
    printf '%s  %s\n' "$(sha256sum "$APP/$rel" | awk '{print $1}')" "$rel" >> "$out"
  done
}

restore_overlay() {
  set +e
  [[ -n "$APP" && -n "$BACKUP" && -f "$BACKUP/app-before-22.tar" ]] || return 0
  warn "Откатываю только слой 22 фиксов к чистому GitHub-состоянию..."
  rm -rf "$APP/app"
  tar -xpf "$BACKUP/app-before-22.tar" -C "$APP"
  if [[ "$VERSION_WAS_PRESENT" -eq 1 && -f "$BACKUP/VERSION.before" ]]; then
    cp -a "$BACKUP/VERSION.before" "$APP/VERSION"
  else
    rm -f "$APP/VERSION"
  fi
  systemctl restart sg-gateway.service >/dev/null 2>&1 || true
}

on_error() {
  local rc=$?
  trap - ERR EXIT INT TERM
  if [[ "$OVERLAY_STARTED" -eq 1 && "$OVERLAY_COMMITTED" -eq 0 ]]; then restore_overlay; fi
  cleanup
  exit "$rc"
}

verify_only() {
  extract_embedded
  ok "встроенный официальный GitHub bootstrap проверен"
  ok "точный пакет из 22 фиксов проверен: $REPLAY_SHA"
  log "Этот режим не обращался к EC2 и ничего не устанавливал."
}

install_all() {
  [[ "$(id -u)" -eq 0 ]] || fail "запустите через sudo"
  if [[ -e /opt/sg-gateway || -e /etc/sg-gateway || -e /var/lib/sg-gateway ]]; then
    fail "это FULL CLEAN тест: используйте новую чистую EC2 без установленного SG-Gateway"
  fi
  extract_embedded
  trap on_error ERR EXIT INT TERM

  log "1/2 — устанавливаю текущий GitHub main официальным способом..."
  SG_GATEWAY_GITHUB_BRANCH=main bash "$BOOTSTRAP"
  BASE_INSTALLED=1
  detect_app || fail "после GitHub install не найден /opt/sg-gateway"
  systemctl is-active --quiet sg-gateway.service || fail "sg-gateway.service не active после GitHub install"
  [[ -f "$APP/app/main.py" ]] || fail "app/main.py не найден после GitHub install"
  [[ -f "$APP/app/web/templates/connections.html" ]] || fail "Connections не найден после GitHub install"

  protected_hashes "$PROTECTED_BEFORE"

  BACKUP="/var/lib/sg-gateway/hotfix-backups/$(date -u +%Y%m%d-%H%M%S)-github-clean-before-22"
  mkdir -p "$BACKUP"
  tar -cpf "$BACKUP/app-before-22.tar" -C "$APP" app
  if [[ -f "$APP/VERSION" ]]; then VERSION_WAS_PRESENT=1; cp -a "$APP/VERSION" "$BACKUP/VERSION.before"; fi

  log "2/2 — накладываю ровно те же 22 принятых фикса..."
  OVERLAY_STARTED=1
  bash "$REPLAY" --all

  local after="$TMP/protected-after.sha256"
  protected_hashes "$after"
  cmp -s "$PROTECTED_BEFORE" "$after" || fail "22 фикса изменили защищённые Connections/Mihomo/sing-box/exports/hostd файлы"

  python3 -m py_compile "$APP/app/main.py"
  systemctl restart sg-gateway.service
  sleep 2
  systemctl is-active --quiet sg-gateway.service || fail "sg-gateway.service не active после 22 фиксов"
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 5 http://127.0.0.1:18080/health >/dev/null || fail "backend /health не отвечает после 22 фиксов"
  fi

  OVERLAY_COMMITTED=1
  trap - ERR EXIT INT TERM
  cleanup
  ok "Чистый GitHub main установлен"
  ok "Ровно 22 зафиксированных фикса применены"
  ok "Защищённые Connections/Mihomo/sing-box/exports/hostd файлы не изменились"
  ok "sg-gateway.service active; backend /health отвечает"
  printf '\n[SG-Gateway] Теперь проверяем вручную: System → Security → Connections → ссылки.\n'
}

case "${1:-}" in
  --verify-only) verify_only ;;
  "") install_all ;;
  *) fail "использование: $0 [--verify-only]" ;;
esac
exit 0

