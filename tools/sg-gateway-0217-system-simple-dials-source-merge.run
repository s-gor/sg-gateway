#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${SG_GATEWAY_APP_ROOT:-$(pwd)}"
MAIN="$ROOT/app/main.py"
BASE="$ROOT/app/web/templates/base.html"
SYSTEM="$ROOT/app/web/templates/system.html"
STATIC="$ROOT/app/web/static"
TESTS="$ROOT/tests"
NEW_CSS="$STATIC/sg-system-simple-dials-v1.css"

fail() { printf '[SG-Gateway] [ERROR] %s\n' "$*" >&2; exit 1; }
ok() { printf '[SG-Gateway] [OK] %s\n' "$*"; }

[[ -f "$MAIN" ]] || fail "Не найден app/main.py"
[[ -f "$BASE" ]] || fail "Не найден app/web/templates/base.html"
[[ -f "$SYSTEM" ]] || fail "Не найден app/web/templates/system.html"
[[ -d "$STATIC" ]] || fail "Не найден app/web/static"

python3 - "$MAIN" "$BASE" "$SYSTEM" "$TESTS" <<'PY'
from pathlib import Path
import re
import sys

main_path = Path(sys.argv[1])
base_path = Path(sys.argv[2])
system_path = Path(sys.argv[3])
tests_root = Path(sys.argv[4])

# ---------------------------------------------------------------------------
# 1. app/main.py: keep the accepted clean RAM accounting, but remove the
#    multi-sector dial construction. Memory and Disk become two-part dials:
#    used = blue, free/available = neutral.
# ---------------------------------------------------------------------------
main = main_path.read_text(encoding="utf-8")
original_main = main

clean_memory_block = '''    used = max(0, total - available)
    used_percent = round(used * 100 / total) if total else 0
    memory_state, memory_label = _resource_state(used_percent)

    panel_rss = _process_rss(("python", "waitress"))
    web_rss = _process_rss(("nginx",))

    # Build one non-overlapping partition of total RAM for the detail rows.
    # Linux MemAvailable already includes reclaimable cache, therefore cache
    # must not be added on top of used memory.
    panel = min(max(0, panel_rss), used)
    web = min(max(0, web_rss), max(0, used - panel))
    other = max(0, used - panel - web)
    cache = max(0, available - free)
    free_partition = max(0, total - used - cache)

    memory_parts = [
        ("panel", "SG-Gateway", "Панель и дочерние процессы", panel, "#8279B8"),
        ("web", "Веб-сервер", "Процессы Nginx и reverse proxy, если используются", web, "#B9839A"),
        ("system", "Системные службы", "Остальные процессы операционной системы", other, "#7897A8"),
        ("cache", "Файловый кэш", "Доступная память, занятая файловым кэшем", cache, "#C9A15B"),
        ("free", "Доступно", f"Доступно с учётом кэша: {_format_bytes(available)}", free_partition, "var(--sg-simple-dial-empty)"),
    ]
'''

memory_block_pattern = re.compile(
    r'(?ms)^    cached = mem\.get\("Cached", 0\) \+ mem\.get\("SReclaimable", 0\)\n'
    r'.*?^    memory_parts = \[\n.*?^    \]\n'
)

if memory_block_pattern.search(main):
    main = memory_block_pattern.sub(clean_memory_block, main, count=1)
elif 'panel_rss = _process_rss(("python", "waitress"))' in main:
    # The clean accounting may already be present on a rerun. Normalize only
    # the five detail-row tuples and labels/colors.
    replacements = {
        "panel": '("panel", "SG-Gateway", "Панель и дочерние процессы", panel, "#8279B8"),',
        "web": '("web", "Веб-сервер", "Процессы Nginx и reverse proxy, если используются", web, "#B9839A"),',
        "system": '("system", "Системные службы", "Остальные процессы операционной системы", other, "#7897A8"),',
        "cache": '("cache", "Файловый кэш", "Доступная память, занятая файловым кэшем", cache, "#C9A15B"),',
        "free": '("free", "Доступно", f"Доступно с учётом кэша: {_format_bytes(available)}", free_partition, "var(--sg-simple-dial-empty)"),',
    }
    for key, value in replacements.items():
        main, n = re.subn(
            rf'(?m)^\s*\("{key}",[^\n]*\),\s*$',
            '        ' + value,
            main,
            count=1,
        )
        if n != 1:
            raise SystemExit(f"Не удалось нормализовать строку памяти: {key}")
else:
    raise SystemExit("Не найден исходный блок расчёта памяти")

# Remove the old per-sector gradient builder while preserving the detail rows.
rows_pattern = re.compile(
    r'(?ms)^    start = 0\.0\n'
    r'^    gradient_parts: list\[str\] = \[\]\n'
    r'^    memory_rows: list\[dict\] = \[\]\n'
    r'^    for key, label, note, amount, color in memory_parts:\n'
    r'.*?^        start = end\n'
)
rows_replacement = '''    memory_rows: list[dict] = []
    for key, label, note, amount, color in memory_parts:
        percent = round(amount * 100 / total, 1) if total else 0
        memory_rows.append(
            {
                "key": key,
                "label": label,
                "note": note,
                "value": _format_bytes(amount),
                "percent": f"{percent:.1f}%",
                "color": color,
            }
        )
'''
if rows_pattern.search(main):
    main = rows_pattern.sub(rows_replacement, main, count=1)
elif 'gradient_parts.append' in main:
    raise SystemExit("Старый секторный построитель памяти найден в неизвестной форме")

# Replace the Memory gradient mapping with one blue used sector + neutral free.
memory_gradient_pattern = re.compile(
    r'(?ms)(^        "memory": \{.*?^            "gradient": )'
    r'("conic-gradient\(" \+ ", "\.join\(gradient_parts\) \+ "\)"|\(.*?^            \))'
    r'(,\n^            "rows": memory_rows,)'
)
memory_gradient_value = '''(
                "conic-gradient(var(--sg-simple-dial-used) 0 "
                f"{used_percent}%, var(--sg-simple-dial-empty) {used_percent}% 100%)"
            )'''
main, memory_gradient_count = memory_gradient_pattern.subn(
    lambda m: m.group(1) + memory_gradient_value + m.group(3),
    main,
    count=1,
)
if memory_gradient_count != 1 and 'f"{used_percent}%, var(--sg-simple-dial-empty)' not in main:
    raise SystemExit("Не удалось заменить градиент Памяти")

# Replace the Disk gradient with one blue used sector + neutral free.
disk_gradient_pattern = re.compile(
    r'(?ms)(^        "disk": \{.*?^            "gradient": )'
    r'\(\n\s*"conic-gradient\([^\n]*\n\s*f"\{disk_percent\}%,[^\n]*\n\s*\)'
    r'(,\n^        \},\n^        "cpu": \{)'
)
disk_gradient_value = '''(
                "conic-gradient(var(--sg-simple-dial-used) 0 "
                f"{disk_percent}%, var(--sg-simple-dial-empty) {disk_percent}% 100%)"
            )'''
main, disk_gradient_count = disk_gradient_pattern.subn(
    lambda m: m.group(1) + disk_gradient_value + m.group(2),
    main,
    count=1,
)
if disk_gradient_count != 1 and 'f"{disk_percent}%, var(--sg-simple-dial-empty)' not in main:
    raise SystemExit("Не удалось заменить градиент Диска")

if main == original_main:
    raise SystemExit("app/main.py не изменён")
main_path.write_text(main, encoding="utf-8", newline="\n")

# ---------------------------------------------------------------------------
# 2. Templates: remove the old sector CSS/JS and all experimental local patch
#    links. Load one permanent simple-dials stylesheet last for System.
# ---------------------------------------------------------------------------
obsolete = [
    "sg-system-dial-sg-gateway-sector-v1.css",
    "sg-system-dial-sg-gateway-sector-v1.js",
    "sg-system-dial-math-sync-v1.js",
    "sg-system-dial-harmony-palette-v1.css",
    "sg-system-sg-gateway-indigo-v1.css",
    "sg-system-replace-greenish-accents-v1.css",
    "sg-system-memory-available-button-green-v1.css",
    "sg-system-memory-available-sage-v1.css",
    "sg-system-free-space-neutral-v1.css",
    "sg-system-disk-free-neutral-direct-v1.css",
    "sg-system-available-label-over-empty-sector-v1.css",
    "sg-system-available-label-over-empty-sector-v1.js",
    "sg-system-simple-dials-blue-neutral-v1.css",
    "sg-system-simple-dials-v1.css",
]

for path in (base_path, system_path):
    text = path.read_text(encoding="utf-8")
    for filename in obsolete:
        # System assets in base.html can be wrapped by a Jinja condition on
        # the same physical line. Remove the complete line that contains the
        # exact obsolete link/script, not only lines that start with <link>.
        text = re.sub(
            rf'^[^\n]*(?:<link|<script)\b[^\n]*{re.escape(filename)}[^\n]*\n?',
            "",
            text,
            flags=re.MULTILINE,
        )

    if path == base_path:
        marker = "</head>"
        link = (
            "  {% if active_page|default('') == 'system' %}"
            "<link rel=\"stylesheet\" href=\"{{ url_for('static', filename='sg-system-simple-dials-v1.css') }}?v={{ app_version }}\">"
            "{% endif %}\n"
        )
        pos = text.find(marker)
        if pos < 0:
            raise SystemExit("Не найден </head> в base.html")
        text = text[:pos] + link + text[pos:]

    path.write_text(text, encoding="utf-8", newline="\n")

base_check = base_path.read_text(encoding="utf-8")
if base_check.count("sg-system-simple-dials-v1.css") != 1:
    raise SystemExit("Новый CSS подключён не один раз")
for filename in obsolete[:-1]:
    if filename in base_check or filename in system_path.read_text(encoding="utf-8"):
        raise SystemExit(f"Осталось устаревшее подключение: {filename}")

# ---------------------------------------------------------------------------
# 3. Tests: update old filename expectations and add a dedicated regression
#    test for the final simple-dial source state.
# ---------------------------------------------------------------------------
if tests_root.exists():
    for test_path in tests_root.rglob("*.py"):
        text = test_path.read_text(encoding="utf-8")
        original = text
        text = text.replace(
            "sg-system-dial-sg-gateway-sector-v1.css",
            "sg-system-simple-dials-v1.css",
        )
        # Old JS markers were tuple entries in the UI marker tests. Remove only
        # lines containing those exact obsolete filenames.
        lines = [
            line for line in text.splitlines()
            if "sg-system-dial-sg-gateway-sector-v1.js" not in line
            and "sg-system-dial-math-sync-v1.js" not in line
        ]
        text = "\n".join(lines) + ("\n" if original.endswith("\n") else "")
        if text != original:
            test_path.write_text(text, encoding="utf-8", newline="\n")

regression = tests_root / "test_system_simple_dials_v1.py"
regression.write_text('''from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]


def test_system_uses_only_simple_blue_neutral_dials():
    main = (ROOT / "app/main.py").read_text(encoding="utf-8")
    base = (ROOT / "app/web/templates/base.html").read_text(encoding="utf-8")
    css = (ROOT / "app/web/static/sg-system-simple-dials-v1.css").read_text(encoding="utf-8")

    assert "sg-system-simple-dials-v1.css" in base
    assert "sg-system-dial-sg-gateway-sector-v1.css" not in base
    assert "sg-system-dial-sg-gateway-sector-v1.js" not in base
    assert "sg-system-dial-math-sync-v1.js" not in base

    assert "var(--sg-simple-dial-used)" in main
    assert "var(--sg-simple-dial-empty)" in main
    assert "gradient_parts.append" not in main
    assert '"free", "Доступно"' in main
    assert "free_partition" in main

    assert "--sg-simple-dial-used: #4F9BFF" in css
    assert "--sg-simple-dial-empty: #233D57" in css
    assert "--sg-simple-dial-empty: #D7E1DD" in css
    assert '[data-sg-cpu-card="1"] .sv1-cpu-dial' in css
    assert "--sg-dial-gateway-percent" not in css
''', encoding="utf-8", newline="\n")
PY

cat > "$NEW_CSS" <<'CSS'
/* SG-Gateway 0.1.0-021.7 — final simple System dials.
   This file changes colors only. Card geometry, heights, rows and spacing are
   intentionally untouched.

   Memory / Disk: occupied part = blue; available/free part = neutral.
   CPU: load = blue; free part = neutral. */

body.page-system {
  --sg-simple-dial-used: #4F9BFF;
}

html[data-theme="dark"] body.page-system,
html[data-theme="graphite"] body.page-system,
body.page-system:not([data-theme]) {
  --sg-simple-dial-empty: #233D57;
}

html[data-theme="light"] body.page-system {
  --sg-simple-dial-empty: #D7E1DD;
}

body.page-system [data-sg-memory-card="1"] .sv1-donut,
body.page-system [data-sg-disk-card="1"] .sv1-donut {
  background: var(--sv1-gradient) !important;
}

body.page-system [data-sg-cpu-card="1"] .sv1-cpu-dial {
  background:
    conic-gradient(
      from -90deg,
      var(--sg-simple-dial-used) 0 calc(var(--sg-cpu-percent, 0) * 1%),
      var(--sg-simple-dial-empty) calc(var(--sg-cpu-percent, 0) * 1%) 100%
    ) !important;
}
CSS

# Remove obsolete sector and experimental files from the real source tree.
rm -f \
  "$STATIC/sg-system-dial-sg-gateway-sector-v1.css" \
  "$STATIC/sg-system-dial-sg-gateway-sector-v1.js" \
  "$STATIC/sg-system-dial-math-sync-v1.js" \
  "$STATIC/sg-system-dial-harmony-palette-v1.css" \
  "$STATIC/sg-system-sg-gateway-indigo-v1.css" \
  "$STATIC/sg-system-replace-greenish-accents-v1.css" \
  "$STATIC/sg-system-memory-available-button-green-v1.css" \
  "$STATIC/sg-system-memory-available-sage-v1.css" \
  "$STATIC/sg-system-free-space-neutral-v1.css" \
  "$STATIC/sg-system-disk-free-neutral-direct-v1.css" \
  "$STATIC/sg-system-available-label-over-empty-sector-v1.css" \
  "$STATIC/sg-system-available-label-over-empty-sector-v1.js" \
  "$STATIC/sg-system-simple-dials-blue-neutral-v1.css"

python3 -m py_compile "$MAIN"

python3 - "$ROOT" <<'PY'
from pathlib import Path
import re
import sys

root = Path(sys.argv[1])
main = (root / "app/main.py").read_text(encoding="utf-8")
base = (root / "app/web/templates/base.html").read_text(encoding="utf-8")
css = (root / "app/web/static/sg-system-simple-dials-v1.css").read_text(encoding="utf-8")

required_main = [
    'panel_rss = _process_rss(("python", "waitress"))',
    'cache = max(0, available - free)',
    'free_partition = max(0, total - used - cache)',
    '"free", "Доступно"',
    'f"{used_percent}%, var(--sg-simple-dial-empty)',
    'f"{disk_percent}%, var(--sg-simple-dial-empty)',
]
for marker in required_main:
    if marker not in main:
        raise SystemExit(f"Нет обязательного маркера в main.py: {marker}")

if "gradient_parts.append" in main:
    raise SystemExit("В main.py остался секторный построитель Памяти")

if base.count("sg-system-simple-dials-v1.css") != 1:
    raise SystemExit("Новый CSS подключён некорректно")

for old in (
    "sg-system-dial-sg-gateway-sector-v1.css",
    "sg-system-dial-sg-gateway-sector-v1.js",
    "sg-system-dial-math-sync-v1.js",
):
    if old in base:
        raise SystemExit(f"В base.html осталась старая секторная логика: {old}")

for marker in (
    "--sg-simple-dial-used: #4F9BFF",
    "--sg-simple-dial-empty: #233D57",
    "--sg-simple-dial-empty: #D7E1DD",
    '[data-sg-cpu-card="1"] .sv1-cpu-dial',
):
    if marker not in css:
        raise SystemExit(f"Нет обязательного маркера в CSS: {marker}")
PY

if command -v pytest >/dev/null 2>&1; then
  pytest -q "$TESTS/test_system_simple_dials_v1.py"
fi

git -C "$ROOT" diff --check
ok "Секторная логика удалена из исходников."
ok "Память и Диск: занятое синим, пустое нейтральным."
ok "CPU: загрузка синим, свободное нейтральным."
ok "Геометрия карточек и строк не изменена."
