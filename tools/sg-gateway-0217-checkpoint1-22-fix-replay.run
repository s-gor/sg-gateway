#!/usr/bin/env bash
set -Eeuo pipefail

TITLE="SG-Gateway 0.1.0-021.7 — Checkpoint1 exact 22-fix replay"
SERVICE="${SG_GATEWAY_SERVICE:-sg-gateway.service}"
PAYLOAD_SHA="b6093c93e4305ac8e1dd2fc75c94b14e2189da8fd23e3928e58b1a8ddcbb951e"
TMP="$(mktemp -d /tmp/sg0217-cp1-replay.XXXXXX)"
FILES="$TMP/files"
APP=""
BACKUP=""
VERSION_WAS_PRESENT=0
COMMITTED=0

log() { printf '[SG-Gateway] %s\n' "$*"; }
ok()  { printf '\033[32m[SG-Gateway] [OK]\033[0m %s\n' "$*"; }
fail(){ printf '\033[31m[SG-Gateway] [ОШИБКА]\033[0m %s\n' "$*" >&2; exit 1; }
cleanup() { rm -rf "$TMP"; }

detect_app() {
  if [[ -n "${SG_GATEWAY_APP_ROOT:-}" && -f "${SG_GATEWAY_APP_ROOT}/app/web/templates/system.html" ]]; then APP="${SG_GATEWAY_APP_ROOT}"; return 0; fi
  if [[ -f /opt/sg-gateway/app/web/templates/system.html ]]; then APP=/opt/sg-gateway; return 0; fi
  if [[ -f /opt/sg-gateway/current/app/web/templates/system.html ]]; then APP=/opt/sg-gateway/current; return 0; fi
  return 1
}

extract_payload() {
  mkdir -p "$FILES"
  awk '/^__PAYLOAD_BEGIN__$/{p=1;next} /^__PAYLOAD_END__$/{p=0} p' "$0" | tr -d '\r\n' | base64 -d > "$TMP/payload.tar.gz"
  [[ "$(sha256sum "$TMP/payload.tar.gz" | awk '{print $1}')" == "$PAYLOAD_SHA" ]] || fail "повреждён встроенный payload"
  tar -xzf "$TMP/payload.tar.gz" -C "$FILES"
  (cd "$FILES" && sha256sum -c SHA256-22.txt >/dev/null) || fail "SHA одного из 22 фиксов не совпал"
  while IFS= read -r f; do [[ -n "$f" ]] || continue; bash -n "$FILES/$f" || fail "bash -n: $f"; done < "$FILES/ORDER-22.txt"
}

list_steps() {
  extract_payload
  printf '\n===== %s =====\n\n' "$TITLE"
  echo "ТОЧНЫЙ состав Checkpoint1: 22 фикса."
  echo "Это НЕ утверждение, что здесь все удачные фиксы за весь день."
  echo
  nl -w2 -s'. ' "$FILES/ORDER-22.txt"
}

restore_step() {
  set +e
  if [[ "$COMMITTED" -eq 0 && -n "$APP" && -n "$BACKUP" && -f "$BACKUP/app-before.tar" ]]; then
    log "Откатываю только текущий шаг..."
    rm -rf "$APP/app"
    tar -xpf "$BACKUP/app-before.tar" -C "$APP"
    if [[ "$VERSION_WAS_PRESENT" -eq 1 && -f "$BACKUP/VERSION.before" ]]; then cp -a "$BACKUP/VERSION.before" "$APP/VERSION"; else rm -f "$APP/VERSION"; fi
    systemctl restart "$SERVICE" >/dev/null 2>&1 || true
  fi
}

run_one() {
  local n="$1" f total stamp
  total=$(grep -c . "$FILES/ORDER-22.txt")
  [[ "$n" =~ ^[0-9]+$ ]] || fail "номер шага должен быть 1..$total"
  (( n >= 1 && n <= total )) || fail "номер шага должен быть 1..$total"
  f=$(sed -n "${n}p" "$FILES/ORDER-22.txt")
  [[ "${EUID:-$(id -u)}" -eq 0 ]] || fail "для применения шага нужен sudo"
  detect_app || fail "не найден установленный SG-Gateway"

  stamp="$(date -u +%Y%m%d-%H%M%S)-$$"
  BACKUP="/var/lib/sg-gateway/hotfix-backups/${stamp}-checkpoint1-replay-step$(printf '%02d' "$n")"
  mkdir -p "$BACKUP/hotfixes"
  tar -cpf "$BACKUP/app-before.tar" -C "$APP" app
  if [[ -f "$APP/VERSION" ]]; then VERSION_WAS_PRESENT=1; cp -a "$APP/VERSION" "$BACKUP/VERSION.before"; else VERSION_WAS_PRESENT=0; fi
  printf '%s\n' '0.1.0-021.7' > "$APP/VERSION"

  export SG_GATEWAY_APP_ROOT="$APP"
  export SG_GATEWAY_SERVICE="$SERVICE"
  export SG_GATEWAY_TEST_MODE=1
  export SG_GATEWAY_BACKUP_ROOT="$BACKUP/hotfixes"

  COMMITTED=0
  trap 'rc=$?; trap - EXIT ERR INT TERM; if [[ $rc -ne 0 ]]; then restore_step; fi; cleanup; exit $rc' EXIT ERR INT TERM

  printf '\n[SG-Gateway] ШАГ %s/%s: %s\n' "$n" "$total" "$f"
  bash "$FILES/$f"

  if [[ "$VERSION_WAS_PRESENT" -eq 1 ]]; then cp -a "$BACKUP/VERSION.before" "$APP/VERSION"; else rm -f "$APP/VERSION"; fi
  [[ -f "$APP/app/main.py" ]] && python3 -m py_compile "$APP/app/main.py"
  if [[ -x "$APP/.venv/bin/python" ]]; then
    "$APP/.venv/bin/python" - "$APP/app/web/templates" <<'PYJ'
from pathlib import Path
from jinja2 import Environment
import sys
env=Environment(); root=Path(sys.argv[1])
for p in root.glob('*.html'):
    env.parse(p.read_text(encoding='utf-8'))
PYJ
  fi
  systemctl restart "$SERVICE"
  sleep 2
  systemctl is-active --quiet "$SERVICE" || fail "$SERVICE не active после шага $n"

  COMMITTED=1
  trap - EXIT ERR INT TERM
  cleanup
  ok "ШАГ $n применён: $f"
  log "Backup: $BACKUP"
}

main() {
  case "${1:---list}" in
    --list) list_steps ;;
    --verify-only) extract_payload; ok "payload и SHA всех 22 фиксов проверены" ;;
    --step) [[ -n "${2:-}" ]] || fail "использование: --step N"; extract_payload; run_one "$2" ;;
    --all)
      extract_payload
      total=$(grep -c . "$FILES/ORDER-22.txt")
      cleanup
      for n in $(seq 1 "$total"); do "$0" --step "$n"; done
      ;;
    *) fail "использование: $0 --list | --verify-only | --step N | --all" ;;
  esac
}

main "$@"
exit 0

